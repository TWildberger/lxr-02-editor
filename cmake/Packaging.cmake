# Install staging and archives contain only explicitly selected product bundles/docs.
set(CPACK_COMPONENTS_ALL "")
foreach(product KitForge VSynthXT)
    if(TARGET ${product})
        list(APPEND CPACK_COMPONENTS_ALL ${product})
        foreach(format IN LISTS COMPANION_FORMATS)
            get_target_property(artifact ${product}_${format} JUCE_PLUGIN_ARTEFACT_FILE)
            if(format STREQUAL "Standalone" AND NOT APPLE)
                install(PROGRAMS "${artifact}" DESTINATION "${format}" COMPONENT ${product})
            else()
                install(DIRECTORY "${artifact}" DESTINATION "${format}" COMPONENT ${product})
            endif()
        endforeach()
        if(product STREQUAL "VSynthXT")
            install(FILES "${PROJECT_SOURCE_DIR}/docs/vsynthxt/README.md"
                DESTINATION docs COMPONENT ${product})
        else()
            install(FILES "${PROJECT_SOURCE_DIR}/README.md"
                DESTINATION docs COMPONENT ${product})
        endif()
        install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION docs COMPONENT ${product})
    endif()
endforeach()
set(CPACK_GENERATOR "ZIP")
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
set(CPACK_COMPONENTS_GROUPING IGNORE)
set(CPACK_PACKAGE_NAME "HardwareCompanions")
set(CPACK_ARCHIVE_KITFORGE_FILE_NAME "KitForge-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_ARCHIVE_VSYNTHXT_FILE_NAME "VSynthXTCompanion-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
include(CPack)
